# Copy to .env to set build-time values for the pages. Optional; the defaults are
# right for development. The release build sets these from the repository's
# Actions variables instead.

# The API the pages talk to. Default (unset or empty): /api/v1 on the same origin;
# `npm run dev` proxies /api to http://localhost:3000, see SHH_DEV_PROXY. The
# hosted instance's release build uses https://api.shhnote.com/v1. Set it only
# for an API on another origin, which must allow this one; give
# scripts/check-external.sh the same value, since it does not read this file.
# PUBLIC_SHH_API_BASE=http://localhost:3000/api/v1
