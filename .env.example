# Copy to .env to set build-time values for the pages. Both are optional; the
# defaults are right for production, where the API is on the same origin.

# The API the pages talk to. Default: /api/v1 (same origin; in development
# `npm run dev` proxies /api to http://localhost:3000, see SHH_DEV_PROXY).
# Set it only for an API on another origin, which must allow this one.
# PUBLIC_SHH_API_BASE=http://localhost:3000/api/v1

# The largest secret body (bytes) a reveal accepts before the server's /config
# answers. Default: 67108864 (64 MiB, this instance's max_blob_bytes).
# PUBLIC_SHH_MAX_BLOB_BYTES=67108864
