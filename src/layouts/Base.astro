---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { dir, type Locale } from '../lib/i18n';
import { getStrings } from '../lib/strings';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const t = getStrings(locale);
---

<!doctype html>
<html lang={locale} dir={dir(locale)} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? t.site.title}</title>
    <meta name="description" content={description ?? t.site.description} />
    <link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script src="../scripts/theme.ts"></script>
  </head>
  <body>
    <a class="skip-link" href="#content">{t.nav.skip}</a>
    <Header locale={locale} />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
