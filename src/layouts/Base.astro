---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { availableLocales, defaultLocale, dir, ogLocales, type Locale } from '../lib/i18n';
import { site } from '../lib/site';
import { getStrings, uiStrings } from '../lib/strings';
import { argon2Url } from '../lib/instance';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Pages that search engines should not index (the secret interstitials). */
  noindex?: boolean;
  /** Home and /s fetch the Argon2 module on every visit (conformance item 10). */
  prefetchArgon2?: boolean;
  /** The locales this page is built in; the hreflang alternates and the switcher use it. */
  locales?: readonly Locale[];
}

const { locale, title, description, noindex = false, prefetchArgon2 = false, locales = availableLocales } = Astro.props;
const t = getStrings(locale);
const pageTitle = title ?? t.site.title;
const pageDescription = description ?? t.site.description;
const canonical = new URL(Astro.url.pathname, site.url).href;
// The same page in every locale it is built in; `x-default` is the English version.
const rest = Astro.url.pathname.replace(/^\/[^/]+\/?/, '');
const alternates = locales.map((code) => ({ code, href: new URL(`/${code}/${rest}`, site.url).href }));
const xDefault = new URL(`/${defaultLocale}/${rest}`, site.url).href;
---

<!doctype html>
<html lang={locale} dir={dir(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="referrer" content="no-referrer" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternates.map(({ code, href }) => <link rel="alternate" hreflang={code} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e0e10" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf9f7" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {locales.filter((code) => code !== locale).map((code) => <meta property="og:locale:alternate" content={ogLocales[code]} />)}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    {prefetchArgon2 && <link rel="prefetch" href={argon2Url} as="fetch" crossorigin="anonymous" />}
    <script src="../scripts/locale.ts"></script>
    <script src="../scripts/chrome.ts"></script>
  </head>
  <body>
    <script type="application/json" data-shh-i18n is:inline set:html={JSON.stringify(uiStrings(locale))} />
    <a class="skip-link" href="#content">{t.nav.skip}</a>
    <Header locale={locale} locales={locales} />
    <main id="content" tabindex="-1">
      <slot />
      {/* Shown by chrome.ts, in place of the page, when the instance answers 503
          `not_configured` (setup not finished in the admin panel). The server shows the
          same page itself when it serves the pages; in `api` mode this stands in for it. */}
      <article class="page" data-shh-setup hidden>
        <section class="section">
          <div class="container">
            <div class="vault">
              <div class="panel stack">
                <span class="badge badge--muted badge--start"><span class="dot"></span>{t.setup.badge}</span>
                <div class="stack--sm">
                  <h1 class="panel__heading">{t.setup.title}</h1>
                  <p>{t.setup.intro}</p>
                </div>
                <ol class="prose">
                  {t.setup.steps.map((step) => <li>{step}</li>)}
                </ol>
              </div>
            </div>
          </div>
        </section>
      </article>
    </main>
    <Footer locale={locale} locales={locales} />
  </body>
</html>
