---
import type { Locale } from '../lib/i18n';
import { getStrings } from '../lib/strings';
import { site } from '../lib/site';
import LocaleMenu from './LocaleMenu.astro';
import ThemeMenu from './ThemeMenu.astro';

interface Props {
  locale: Locale;
  /** The locales the current page is built in, for the language switcher. */
  locales: readonly Locale[];
}

const { locale, locales } = Astro.props;
const t = getStrings(locale);
const base = `/${locale}/`;
---

<header id="header" class="header">
  <nav class="container" aria-label={t.nav.main}>
    <div class="header__logo">
      <a href={base} class="logo__text" aria-label={t.nav.home}><span class="color-accent">shh</span>note</a>
    </div>

    <ul class="header__nav">
      <li class="nav__item"><a href={`${base}how-it-works/`} class="nav__link">{t.nav.how}</a></li>
      <li class="nav__item"><a href={`${base}security/`} class="nav__link">{t.nav.security}</a></li>
      <li class="nav__item"><a href={`${base}faq/`} class="nav__link">{t.nav.faq}</a></li>
      <li class="nav__item"><a href={`${base}about/`} class="nav__link">{t.footer.about}</a></li>
    </ul>

    <ul class="header__user-controls">
      <li class="nav__item"><LocaleMenu locale={locale} locales={locales} icon="translate" /></li>
      <li class="nav__item"><ThemeMenu locale={locale} /></li>
      <li class="nav__item">
        <a href={site.repo} class="icon-link" aria-label={t.nav.poweredBy} target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
        </a>
      </li>
    </ul>
  </nav>
</header>
