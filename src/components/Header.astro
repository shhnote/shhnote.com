---
import type { Locale } from '../lib/i18n';
import { getStrings } from '../lib/strings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getStrings(locale);
const base = `/${locale}/`;
---

<header id="header" class="header">
  <nav class="container" aria-label="Main">
    <div class="header__logo">
      <a href={base} class="logo__text" aria-label={t.nav.home}><span class="color-accent">shh</span>note</a>
    </div>

    <ul class="header__nav">
      <li class="nav__item"><a href={`${base}how-it-works/`} class="nav__link">{t.nav.how}</a></li>
      <li class="nav__item"><a href={`${base}security/`} class="nav__link">{t.nav.security}</a></li>
      <li class="nav__item"><a href={`${base}faq/`} class="nav__link">{t.nav.faq}</a></li>
      <li class="nav__item"><a href={`${base}docs/`} class="nav__link">{t.nav.docs}</a></li>
    </ul>

    <ul class="header__user-controls">
      <li class="nav__item">
        <a href={base} class="nav__link lang-toggle" aria-label={t.nav.language} hreflang={locale}>
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="20" height="20" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
          </svg>
          <span>{locale.toUpperCase()}</span>
        </a>
      </li>
      <li class="nav__item">
        <button type="button" class="nav__link theme-toggle" aria-label={t.nav.theme} data-theme-toggle>
          <span class="icon-light" aria-hidden="true">☀</span>
          <span class="icon-dark" aria-hidden="true">☾</span>
        </button>
      </li>
      <li class="nav__item"><a href={`${base}#create`} class="nav__link header__cta">{t.nav.create}</a></li>
    </ul>
  </nav>
</header>
