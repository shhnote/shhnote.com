---
import pkg from '../../package.json';
import type { Locale } from '../lib/i18n';
import { getStrings } from '../lib/strings';
import { site } from '../lib/site';
import LocaleMenu from './LocaleMenu.astro';
import ThemeMenu from './ThemeMenu.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getStrings(locale);
const base = `/${locale}/`;
const repo = site.repo;
---

<footer id="footer" class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={base} class="logo__text" aria-label={t.nav.home}><span class="color-accent">shh</span>note</a>
        <p>{t.site.description}</p>
        <div class="footer-controls">
          <LocaleMenu locale={locale} icon="globe" />
          <ThemeMenu locale={locale} />
        </div>
      </div>
      <div class="footer-col">
        <h2 class="footer-col__title">{t.footer.product}</h2>
        <ul>
          <li><a href={`${base}how-it-works/`}>{t.nav.how}</a></li>
          <li><a href={`${base}security/`}>{t.nav.security}</a></li>
          <li><a href={`${base}faq/`}>{t.nav.faq}</a></li>
          <li><a href={`${base}docs/`}>{t.nav.api}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h2 class="footer-col__title">{t.footer.legal}</h2>
        <ul>
          <li><a href={`${base}privacy/`}>{t.footer.privacy}</a></li>
          <li><a href={`${base}terms/`}>{t.footer.terms}</a></li>
          <li><a href={`${base}acceptable-use/`}>{t.footer.acceptableUse}</a></li>
          <li><a href={`${base}about/`}>{t.footer.about}</a></li>
          <li><a href={`${base}contact/`}>{t.footer.contact}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h2 class="footer-col__title">{t.footer.openSource}</h2>
        <ul>
          <li><a href={repo} target="_blank" rel="noopener">{t.footer.github}</a></li>
          <li><a href={`${repo}/issues`} target="_blank" rel="noopener">{t.footer.issue}</a></li>
          <li><a href={`${repo}#readme`} target="_blank" rel="noopener">{t.footer.selfHost}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-bottom__text">
        <div>{t.footer.copyright}</div>
        <div class="footer-versions">
          {t.footer.poweredBy} <a href={repo} target="_blank" rel="noopener">shhnote</a> ({pkg.version})
          · {t.footer.backend} <span data-shh-server-version>—</span>
        </div>
      </div>
    </div>
  </div>
</footer>
