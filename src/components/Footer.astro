---
import type { Locale } from '../lib/i18n';
import { getStrings } from '../lib/strings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getStrings(locale);
const base = `/${locale}/`;
const repo = 'https://github.com/shhnote/shhnote';
---

<footer id="footer" class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={base} class="logo__text" aria-label={t.nav.home}><span class="color-accent">shh</span>note</a>
        <p>{t.site.description}</p>
      </div>
      <div class="footer-col">
        <h4>{t.footer.product}</h4>
        <ul>
          <li><a href={`${base}how-it-works/`}>{t.nav.how}</a></li>
          <li><a href={`${base}security/`}>{t.nav.security}</a></li>
          <li><a href={`${base}faq/`}>{t.nav.faq}</a></li>
          <li><a href={`${base}docs/`}>{t.nav.docs}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>{t.footer.legal}</h4>
        <ul>
          <li><a href={`${base}privacy/`}>{t.footer.privacy}</a></li>
          <li><a href={`${base}terms/`}>{t.footer.terms}</a></li>
          <li><a href={`${base}acceptable-use/`}>{t.footer.acceptableUse}</a></li>
          <li><a href={`${base}about/`}>{t.footer.about}</a></li>
          <li><a href={`${base}contact/`}>{t.footer.contact}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>{t.footer.openSource}</h4>
        <ul>
          <li><a href={repo} rel="noopener">{t.footer.github}</a></li>
          <li><a href={`${repo}/issues`} rel="noopener">{t.footer.issue}</a></li>
          <li><a href={`${repo}#readme`} rel="noopener">{t.footer.selfHost}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div>{t.footer.copyright}</div>
      <div>{t.footer.claims}</div>
    </div>
  </div>
</footer>
