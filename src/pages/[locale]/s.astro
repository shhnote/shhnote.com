---
import Base from '../../layouts/Base.astro';
import { defaultLocale, type Locale } from '../../lib/i18n';
import { getStrings } from '../../lib/strings';

export function getStaticPaths() {
  return [{ params: { locale: defaultLocale } }];
}

const locale = Astro.params.locale as Locale;
const t = getStrings(locale);
const s = t.secret;
const base = `/${locale}/`;
---

{/* Static for every secret: the script reads the fragment and nothing is fetched until the button is pressed. */}
<Base locale={locale} title={`${s.title} — shhnote`} noindex prefetchArgon2>
  <article class="page page--secret" data-shh-page="reveal">
    <section class="section section--panel">
      <div class="container">
        <div class="vault" data-shh-state="armed">
          <div class="panel panel--center stack">
            <span class="badge"><span class="dot"></span>{s.armed.badge}</span>

            <div class="lock-badge">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15.5" r="1.2"/></svg>
            </div>

            <div class="stack--sm">
              <h1 class="panel__heading">{s.armed.title}</h1>
              <p>{s.armed.intro}</p>
            </div>

            <noscript>
              <p class="callout callout--notice">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10.3 4.3 1.8 19a1.5 1.5 0 0 0 1.3 2.2h17.8a1.5 1.5 0 0 0 1.3-2.2L13.7 4.3a1.5 1.5 0 0 0-2.6 0z"/><path d="M12 9.5v4"/><path d="M12 17h.01"/></svg>
                <span>{s.armed.noscript}</span>
              </p>
            </noscript>

            <form class="stack--sm" data-shh-form="reveal">
              <button type="submit" class="btn btn--primary btn--lg w-full" data-shh-reveal><span>{s.armed.reveal}</span></button>
              <p class="input-help text-center">{s.armed.passphraseNote}</p>
              <p class="status text-center" role="status" aria-live="polite" data-shh-status></p>
            </form>

            <div class="callout">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 3l18 18"/><path d="M10.6 5.1A9.4 9.4 0 0 1 12 5c6 0 10 7 10 7a16 16 0 0 1-3 3.7M6.6 6.6A16 16 0 0 0 2 12s4 7 10 7a9.3 9.3 0 0 0 4.4-1.1"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
              <span>{s.armed.callout}</span>
            </div>

            <ul class="info-chips info-chips--center">
              <li><span class="dot"></span>{s.armed.chipE2e}</li>
              <li>{s.armed.chipNoAccount}</li>
            </ul>
          </div>
        </div>

        <div class="vault" data-shh-state="working" hidden aria-live="polite">
          <div class="panel panel--center stack">
            <span class="badge badge--muted"><span class="dot"></span>{s.working.badge}</span>

            <div class="lock-badge">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="15" r="4.2"/><path d="M10.9 12.1 20 3"/><path d="M16.5 6.5 19 9"/><path d="M14 9l2 2"/></svg>
            </div>

            <div class="stack--sm">
              <h1 class="panel__heading">{s.working.title}</h1>
              <p>{s.working.intro}</p>
            </div>

            <div class="stack--sm">
              <div class="progress" aria-hidden="true"><i></i></div>
              <div class="dots" aria-hidden="true"><i></i><i></i><i></i></div>
            </div>

            <p class="input-help text-center" data-shh-status="working">{s.working.fetching}</p>
          </div>
        </div>

        <div class="vault" data-shh-state="passphrase" hidden>
          <div class="panel panel--center stack">
            <span class="badge"><span class="dot"></span>{s.passphrase.badge}</span>

            <div class="lock-badge">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15.5" r="1.2"/></svg>
            </div>

            <div class="stack--sm">
              <h1 class="panel__heading">{s.passphrase.title}</h1>
              <p>{s.passphrase.intro}</p>
            </div>

            <form class="stack--sm" data-shh-form="passphrase">
              <div class="form-field">
                <label class="form-label visually-hidden" for="reveal-passphrase">{s.passphrase.label}</label>
                <div class="pwd-input" data-shh-pwd-input>
                  <input class="form-input" type="password" id="reveal-passphrase" name="passphrase" autocomplete="off" placeholder={s.passphrase.label} />
                  <button type="button" aria-label={t.home.form.passphraseToggle} aria-pressed="false" data-shh-pwd-toggle>
                    <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="24" height="24" aria-hidden="true" data-label="show"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
                    <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="24" height="24" aria-hidden="true" data-label="hide"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88"/></svg>
                  </button>
                </div>
              </div>
              <p class="status text-center" role="status" aria-live="polite" data-shh-status></p>
              <button type="submit" class="btn btn--primary btn--lg w-full"><span>{s.passphrase.submit}</span></button>
            </form>
          </div>
        </div>

        <div class="vault vault--wide" data-shh-state="revealed" hidden>
          <div class="panel stack">
            <div class="stack--sm">
              <span class="badge badge--danger badge--start" data-shh-lifetime><span class="dot"></span><span data-shh-lifetime-text>{s.revealed.singleView}</span></span>
              <h1 class="panel__heading panel__heading--after-badge">{s.revealed.title}</h1>
              <p>{s.revealed.intro}</p>
            </div>

            <div class="secret-output" data-shh-text-block hidden>
              <div class="secret-output__bar">
                <span>{s.revealed.outputLabel}</span>
                <button type="button" class="iconbtn" data-shh-copy="text">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="1.5"/><path d="M5 15V6a1.5 1.5 0 0 1 1.5-1.5H15"/></svg>
                  <span>{s.revealed.copy}</span>
                </button>
              </div>
              <pre data-shh-text></pre>
            </div>

            <ul class="file-cards" data-shh-files></ul>

            <div class="callout callout--danger">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3l7 3v5c0 4.2-3 7.4-7 9-4-1.6-7-4.8-7-9V6z"/></svg>
              <span>{s.revealed.closeWarning}</span>
            </div>

            <div class="btn-row btn-row--center">
              <a class="btn btn--primary btn--lg" href={`${base}#create`}><span>{s.revealed.createOwn}</span></a>
            </div>
          </div>
        </div>

        <div class="vault" data-shh-state="notfound" hidden>
          <div class="panel panel--center stack">
            <span class="badge badge--muted"><span class="dot"></span>{s.notFound.badge}</span>

            <div class="lock-badge lock-badge--muted">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V7.5a4 4 0 0 1 7-2.6"/></svg>
            </div>

            <div class="stack--sm">
              <h1 class="panel__heading">{s.notFound.title}</h1>
              <p>{s.notFound.intro}</p>
            </div>

            <div class="callout">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3l7 3v5c0 4.2-3 7.4-7 9-4-1.6-7-4.8-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
              <span>{s.notFound.callout}</span>
            </div>

            <div class="btn-row btn-row--center">
              <a class="btn btn--primary btn--lg" href={`${base}#create`}><span>{s.notFound.create}</span></a>
              <a class="btn btn--quiet" href={`${base}how-it-works/`}><span>{s.notFound.how}</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </article>
</Base>

<script>
  import { wireReveal } from '@shhnote/client/ui';
  import { t } from '../../scripts/t';

  // Nothing is fetched until a trusted click or key press on the button; the controller
  // enforces that, switches the states and scrubs the fragment after a reveal.
  const page = document.querySelector<HTMLElement>('[data-shh-page="reveal"]');
  if (page) wireReveal(page, { t });
</script>
