---
import Base from '../../layouts/Base.astro';
import { defaultLocale, type Locale } from '../../lib/i18n';
import { getStrings } from '../../lib/strings';

export function getStaticPaths() {
  return [{ params: { locale: defaultLocale } }];
}

const locale = Astro.params.locale as Locale;
const t = getStrings(locale);
const b = t.burn;
const base = `/${locale}/`;
---

{/* Opening this page destroys nothing; only the button does. */}
<Base locale={locale} title={`${b.title} — shhnote`} noindex>
  <article class="page page--secret" data-shh-page="burn">
    <section class="section section--panel">
      <div class="container">
        <div class="vault" data-shh-state="armed">
          <div class="panel panel--center stack">
            <span class="badge badge--danger"><span class="dot"></span>{b.armed.badge}</span>

            <div class="lock-badge lock-badge--danger">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3s5 4 5 9a5 5 0 0 1-10 0c0-1.4.5-2.6 1-3.5.6 1 1.4 1.5 2.2 1.5C11 10 10.5 7 12 3z"/></svg>
            </div>

            <div class="stack--sm">
              <h1 class="panel__heading">{b.armed.title}</h1>
              <p>{b.armed.intro}</p>
            </div>

            <noscript>
              <p class="callout callout--notice">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10.3 4.3 1.8 19a1.5 1.5 0 0 0 1.3 2.2h17.8a1.5 1.5 0 0 0 1.3-2.2L13.7 4.3a1.5 1.5 0 0 0-2.6 0z"/><path d="M12 9.5v4"/><path d="M12 17h.01"/></svg>
                <span>{b.armed.noscript}</span>
              </p>
            </noscript>

            <form class="stack--sm" data-shh-form="burn">
              <div class="btn-row btn-row--center">
                <button type="submit" class="btn btn--danger btn--lg">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><path d="M6 7l1 13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-13"/></svg>
                  <span>{b.armed.confirm}</span>
                </button>
                <a class="btn btn--quiet" href={base}><span>{b.armed.cancel}</span></a>
              </div>
              <p class="status text-center" role="status" aria-live="polite" data-shh-status></p>
            </form>
          </div>
        </div>

        <div class="vault" data-shh-state="done" hidden>
          <div class="panel panel--center stack">
            <span class="badge badge--danger"><span class="dot"></span>{b.done.badge}</span>

            <div class="lock-badge lock-badge--danger">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3s5 4 5 9a5 5 0 0 1-10 0c0-1.4.5-2.6 1-3.5.6 1 1.4 1.5 2.2 1.5C11 10 10.5 7 12 3z"/><path d="M4.5 15.5l15-7" stroke-width="1.6"/></svg>
            </div>

            <div class="stack--sm">
              <h1 class="panel__heading">{b.done.title}</h1>
              <p>{b.done.intro}</p>
            </div>

            <div class="callout">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3l7 3v5c0 4.2-3 7.4-7 9-4-1.6-7-4.8-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
              <span>{b.done.callout}</span>
            </div>

            <div class="btn-row btn-row--center">
              <a class="btn btn--primary btn--lg" href={`${base}#create`}><span>{b.done.create}</span></a>
              <a class="btn btn--quiet" href={`${base}how-it-works/`}><span>{b.done.how}</span></a>
            </div>
          </div>
        </div>

        <div class="vault" data-shh-state="notfound" hidden>
          <div class="panel panel--center stack">
            <span class="badge badge--muted"><span class="dot"></span>{b.notFound.badge}</span>

            <div class="lock-badge lock-badge--muted">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V7.5a4 4 0 0 1 7-2.6"/></svg>
            </div>

            <div class="stack--sm">
              <h1 class="panel__heading">{b.notFound.title}</h1>
              <p>{b.notFound.intro}</p>
            </div>

            <div class="btn-row btn-row--center">
              <a class="btn btn--primary btn--lg" href={base}><span>{b.notFound.home}</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </article>
</Base>

<script>
  import { wireBurn } from '@shhnote/client/ui';
  import { t } from '../../scripts/t';

  // Opening the page destroys nothing; only a trusted submit does, and a share link pasted here is refused locally.
  const page = document.querySelector<HTMLElement>('[data-shh-page="burn"]');
  if (page) wireBurn(page, { t });
</script>
