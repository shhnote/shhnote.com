---
import Base from '../../layouts/Base.astro';
import { availableLocales, type Locale } from '../../lib/i18n';
import { getStrings } from '../../lib/strings';

export function getStaticPaths() {
  return availableLocales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const t = getStrings(locale);
const h = t.home;
const base = `/${locale}/`;
const expiryOptions = Object.entries(h.form.expiry);
const defaultExpiry = '86400';
---

<Base locale={locale} prefetchArgon2>
  <article class="page page--home" data-shh-page="create">
    <section id="create" class="section section--hero">
      <div class="container">
        <header class="section__header-group">
          <h1>{h.hero.title}</h1>
          <p class="section__intro">{h.hero.intro}</p>
        </header>

        <noscript>
          <p class="callout callout--notice">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10.3 4.3 1.8 19a1.5 1.5 0 0 0 1.3 2.2h17.8a1.5 1.5 0 0 0 1.3-2.2L13.7 4.3a1.5 1.5 0 0 0-2.6 0z"/><path d="M12 9.5v4"/><path d="M12 17h.01"/></svg>
            <span>{h.hero.noscript}</span>
          </p>
        </noscript>

        <div class="form-wrapper" data-shh-create-wrapper hidden>
          <form class="create-form" data-shh-form="create" autocomplete="off">
            <div class="content">
              <label class="visually-hidden" for="note">{h.form.noteLabel}</label>
              <textarea id="note" name="note" rows="8" placeholder={h.form.notePlaceholder} spellcheck="false"></textarea>

              <span class="visually-hidden" id="files-label">{h.form.filesLabel}</span>
              <label class="file-upload-area" data-shh-dropzone>
                <input type="file" name="files" multiple aria-labelledby="files-label" aria-describedby="files-hint" />
                <span class="dropzone-content">
                  <svg class="dropzone-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5"/></svg>
                  <span class="dropzone-title"><span class="color-accent">{h.form.filesDrop}</span> {h.form.filesClick}</span>
                  <span class="dropzone-hint" id="files-hint">{h.form.filesHint}<span data-shh-files-limit hidden> · {h.form.filesLimit}</span></span>
                </span>
              </label>
              <ul class="dropzone-files" data-shh-file-list></ul>
              {/* One chosen file; the controller clones this instead of its built-in item. */}
              <template data-shh-template="dropzone-item">
                <li>
                  <span class="dropzone-file"><bdi data-shh-file-name></bdi> <span class="dropzone-file__meta" data-shh-file-meta></span></span>
                  <button type="button" data-shh-file-remove>{t.ui['form-files-remove']}</button>
                </li>
              </template>
            </div>

            <div class="settings">
              <div class="form-field">
                <label class="form-label" for="expiry">{h.form.expiryLabel}</label>
                <div class="select">
                  <select id="expiry" name="expiry" class="form-select" required>
                    {expiryOptions.map(([value, label]) => (
                      <option value={value} selected={value === defaultExpiry}>{label}</option>
                    ))}
                  </select>
                </div>
              </div>

              <label class="form-field form-field--toggle">
                <span class="field-label">
                  <span class="form-label">{h.form.burnLabel}</span>
                  <span class="input-help" id="burn-hint">{h.form.burnHint}</span>
                </span>
                <span class="toggle">
                  <input type="checkbox" id="burn" name="burn" value="1" role="switch" checked aria-describedby="burn-hint" />
                  <span class="track" aria-hidden="true"></span>
                </span>
              </label>

              <div class="form-field">
                <label class="form-label" for="passphrase">{h.form.passphraseLabel} <span class="color-faint">{h.form.passphraseOptional}</span></label>
                <div class="pwd-input" data-shh-pwd-input>
                  <input type="password" name="passphrase" id="passphrase" class="form-input" autocomplete="new-password" aria-describedby="passphrase-hint" />
                  <button type="button" aria-label={h.form.passphraseToggle} aria-pressed="false" data-shh-pwd-toggle>
                    <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="24" height="24" aria-hidden="true" data-label="show"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
                    <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="24" height="24" aria-hidden="true" data-label="hide"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88"/></svg>
                  </button>
                </div>
                <p class="input-help" id="passphrase-hint">{h.form.passphraseHint}</p>
              </div>

              <div class="form-field">
                <p class="disclaimer">{h.form.disclaimer}<a href={`${base}terms/`} target="_blank" rel="noopener">{h.form.disclaimerLink}</a>{h.form.disclaimerEnd}</p>
                <button type="submit" class="btn btn--primary w-full"><span>{h.form.submit}</span></button>
                <p class="status" role="status" aria-live="polite" data-shh-status></p>
              </div>
            </div>
          </form>
        </div>

        <section class="create-result" data-shh-create-result hidden aria-labelledby="result-title">
          <header class="section__header-group">
            <p class="eyebrow">{h.result.eyebrow}</p>
            <h2 class="section__heading" id="result-title">{h.result.title}</h2>
            <p class="section__intro">{h.result.intro}</p>
          </header>

          <div class="vault vault--wide">
            <div class="panel stack">
              <div class="stack--sm">
                <span class="form-label">{h.result.shareLabel}</span>
                <div class="readout">
                  <span class="readout__val" data-shh-share-link></span>
                  <button type="button" class="readout__copy" data-shh-copy="share">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="1.5"/><path d="M5 15V6a1.5 1.5 0 0 1 1.5-1.5H15"/></svg>
                    <span class="copy-label">{h.result.copy}</span><span class="copy-label copy-label--done">{h.result.copied}</span>
                  </button>
                </div>
              </div>

              <ul class="info-chips" aria-label={h.result.chipsLabel}>
                <li><span class="dot"></span><span data-shh-chip="lifetime">{h.result.chipLifetime}</span></li>
                <li><span data-shh-chip="expiry">{h.result.chipExpiry}</span></li>
              </ul>

              <div class="callout" data-shh-passphrase-reminder hidden>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="8" cy="15" r="4"/><path d="m10.85 12.15 8.65-8.65M14 7l3 3M17 4l3 3"/></svg>
                <span>{h.result.passphraseReminder}</span>
              </div>

              <div class="callout">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10.3 4.3 1.8 19a1.5 1.5 0 0 0 1.3 2.2h17.8a1.5 1.5 0 0 0 1.3-2.2L13.7 4.3a1.5 1.5 0 0 0-2.6 0z"/><path d="M12 9.5v4"/><path d="M12 17h.01"/></svg>
                <span><b>{h.result.calloutTitle}</b> {h.result.callout}</span>
              </div>

              <div class="or-divider">{h.result.divider}</div>

              <div class="stack--sm">
                <span class="form-label">{h.result.burnLabel} <span class="color-faint">{h.result.burnAside}</span></span>
                <div class="readout">
                  <span class="readout__val" data-shh-burn-link></span>
                  <button type="button" class="readout__copy" data-shh-copy="burn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="1.5"/><path d="M5 15V6a1.5 1.5 0 0 1 1.5-1.5H15"/></svg>
                    <span class="copy-label">{h.result.copy}</span><span class="copy-label copy-label--done">{h.result.copied}</span>
                  </button>
                </div>
                <p class="input-help">{h.result.burnHint}</p>
              </div>

              <div class="btn-row btn-row--split">
                <a class="btn btn--ghost" href="#" data-shh-open-link><span>{h.result.open}</span></a>
                <button type="button" class="btn btn--danger" data-shh-destroy>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><path d="M6 7l1 13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-13"/></svg>
                  <span>{h.result.destroy}</span>
                </button>
              </div>

              <p class="status text-center" role="status" aria-live="polite" data-shh-status></p>
              <p class="btn-row btn-row--center"><a href={base} class="btn btn--quiet"><span>{h.result.another}</span></a></p>
            </div>
          </div>
        </section>

        <ul class="feature-chips">
          <li>
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"/></svg>
            <span>{h.chips.e2e}</span>
          </li>
          <li>
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88"/></svg>
            <span>{h.chips.zeroKnowledge}</span>
          </li>
          <li>
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636"/></svg>
            <span>{h.chips.noLogs}</span>
          </li>
          <li>
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" width="16" height="16" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 0 0-1.883 2.542l.857 6a2.25 2.25 0 0 0 2.227 1.932H19.05a2.25 2.25 0 0 0 2.227-1.932l.857-6a2.25 2.25 0 0 0-1.883-2.542m-16.5 0V6A2.25 2.25 0 0 1 6 3.75h3.879a1.5 1.5 0 0 1 1.06.44l2.122 2.12a1.5 1.5 0 0 0 1.06.44H18A2.25 2.25 0 0 1 20.25 9v.776"/></svg>
            <span>{h.chips.openSource}</span>
          </li>
        </ul>
      </div>
    </section>

    <section class="section section--how">
      <div class="container">
        <header class="section__header-group">
          <p class="eyebrow">{h.how.eyebrow}</p>
          <h2 class="section__heading">{h.how.title}</h2>
          <p class="section__intro">{h.how.intro}</p>
        </header>

        <div class="fenced-cells">
          {h.how.steps.map((step, i) => (
            <div class="cell">
              <p class="eyebrow">0{i + 1}</p>
              <h3>{step.title} <span class="color-faint">{step.aside}</span></h3>
              <p>{step.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--under-hood">
      <div class="container">
        <header class="section__header-group">
          <p class="eyebrow">{h.hood.eyebrow}</p>
          <h2 class="section__heading">{h.hood.title}</h2>
          <p class="section__intro">{h.hood.intro}</p>
        </header>

        <div class="spec-sheet">
          {h.hood.specs.map((spec) => (
            <div class="spec">
              <p class="eyebrow">{spec.label}</p>
              <div class="spec__val">{spec.value}</div>
              <p>{spec.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--use-cases">
      <div class="container">
        <header class="section__header-group">
          <p class="eyebrow">{h.useCases.eyebrow}</p>
          <h2 class="section__heading">{h.useCases.title}</h2>
          <p class="section__intro">{h.useCases.intro}</p>
        </header>

        <div class="wall-cells">
          {h.useCases.items.map((item) => (
            <article class="use-case">
              <p class="eyebrow">{item.label}</p>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--cta">
      <div class="container">
        <header class="section__header-group">
          <h2 class="section__heading">{h.cta.title}</h2>
          <p class="section__intro">{h.cta.intro}</p>
          <p><a href={`${base}#create`} class="btn btn--primary"><span>{h.cta.button}</span></a></p>
        </header>
      </div>
    </section>
  </article>
</Base>

<script>
  import { getConfig } from '@shhnote/client';
  import { createT, wireCreate } from '@shhnote/client/ui';
  import { apiBase, argon2Url } from '../../lib/instance';

  // The create flow: encrypt in the browser, upload, show the links. Strings come from the
  // page's data-shh-i18n block (createT); the limits come from the instance's /config,
  // which the controller reads and compares itself.
  const page = document.querySelector<HTMLElement>('[data-shh-page="create"]');
  if (page) wireCreate(page, { t: createT(), apiBase, argon2Url });

  // Progress in the button. The controller disables the submit button while it works and
  // writes its progress ("Encrypting…", "Uploading…") and its errors to the one status line
  // under it. While the button is disabled, its label shows that line's text and the line
  // is for screen readers only, so the form does not grow for a moment before the result
  // replaces it. An error is written in the same task that enables the button again, so it
  // stays under the button. Presentation only: the controller's state is read, never set.
  const form = page?.querySelector<HTMLFormElement>('[data-shh-form="create"]');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const label = submit?.querySelector('span');
  const status = form?.querySelector<HTMLElement>('[data-shh-status]');
  if (submit && label && status) {
    const idle = label.textContent;
    const sync = () => {
      const busy = submit.disabled && status.textContent !== '';
      label.textContent = busy ? status.textContent : idle;
      status.classList.toggle('visually-hidden', busy);
    };
    const observer = new MutationObserver(sync);
    observer.observe(status, { childList: true, characterData: true, subtree: true });
    observer.observe(submit, { attributes: true, attributeFilter: ['disabled'] });
  }

  // The size hint under the drop zone comes from the instance (`max_blob_bytes`, the
  // largest padded size it stores), through the package's shared `getConfig`, so it is
  // the same single /config request the controller and the footer make. The string holds
  // a `{limit}` placeholder; the span stays hidden until it is filled.
  const limit = document.querySelector<HTMLElement>('[data-shh-files-limit]');
  if (limit) {
    getConfig(apiBase)
      .then((config) => {
        const mib = Math.floor(config.max_blob_bytes / 1048576);
        const size = mib >= 1 ? `${mib} MB` : `${Math.floor(config.max_blob_bytes / 1024)} KB`;
        limit.textContent = limit.textContent!.replace('{limit}', size);
        limit.hidden = false;
      })
      .catch(() => {});
  }
</script>
